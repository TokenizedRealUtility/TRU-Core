
# ============================================================
# TRU Blockchain Configuration Example
# ============================================================
[network]

# RPC port used by local miners/tools.
rpcport=21832

# P2P blockchain networking port.
p2pPort=21833

# Accept incoming P2P connections.
listen=1

# ------------------------------------------------------------
# RPC BIND
# ------------------------------------------------------------
rpcbind=127.0.0.1

rpcAllowRemote=0

# Maximum number of RPC connections (default: 32)
rpcMaxConnections=32

# ------------------------------------------------------------
# STARTUP PEER / SEED
# ------------------------------------------------------------
addnode=137.184.68.43:21833

# Required multinode/reorg activation
automaticReorg=1

# ------------------------------------------------------------
# Enable Sending TRU from CLI 
# ------------------------------------------------------------
#TRU_RPC_WALLET_SEND_ENABLE=1
#TRU_RPC_WALLET_SEND_MAX_ATOMS=unlimited

# ------------------------------------------------------------
# TRU ARCADE — Native Achievement Publishing (06B)
# ------------------------------------------------------------

# Keep disabled until ready to enable = 1 
TRU_ARCADE_PUBLISH_ENABLE=0

# Address belonging to the connected Headless Core wallet
TRU_ARCADE_PUBLISH_ADDRESS=YOUR_CONNECTED_CORE_ADDRESS

# Browser-generated public approval key (NOT a private key)
TRU_ARCADE_PUBLISH_APPROVER_SPKI_HEX=YOUR_PUBLIC_APPROVAL_KEY

# Maximum network fee per achievement (atoms)
TRU_ARCADE_PUBLISH_MAX_FEE_ATOMS=100000

# Maximum total Arcade network fees per day (atoms)
TRU_ARCADE_PUBLISH_DAILY_FEE_BUDGET_ATOMS=1000000

# ------------------------------------------------------------
# EXTERNAL IP
# ------------------------------------------------------------
#externalip=74.192.87.30

[default]
# Local RPC address used by TRU miners/oracle components.
node.ip=127.0.0.1
node.port=21832

# ------------------------------------------------------------
# TOKEN EVOLUTION / ORACLE
# ------------------------------------------------------------

oracle.address=TRU_ADDRESS_HERE
oracle.wallet=tru.dat

# ------------------------------------------------------------
# AI Agent Settings  
# ------------------------------------------------------------
[agent_checkpoint]
#enabled=1
#policy_file=/path/to/tru-agent-policies/axona/policy.json

# ===========================================================================
[chain]
# Name of the blockchain (default: TRUMain)
chainName=TRUMain
# Network type: mainnet, testnet, regtest (default: mainnet)
networkType=mainnet
