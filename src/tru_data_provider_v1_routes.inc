// Included inside Blockchain::startBlockExplorer. Public read-only GETs.
auto providerReply=[](httplib::Response& res,const nlohmann::json& value){res.set_header("Access-Control-Allow-Origin","*");res.set_header("Cache-Control","no-store");res.set_header("X-Content-Type-Options","nosniff");res.set_content(value.dump(),"application/json");};
g_explorerServer.Get("/api/chain",[this,providerReply](const httplib::Request&,httplib::Response& res){try{providerReply(res,getDataProviderChainV1());}catch(...){res.status=503;providerReply(res,{{"error","chain metadata unavailable"}});}});
g_explorerServer.Get("/api/health",[this,providerReply](const httplib::Request&,httplib::Response& res){try{const auto v=getDataProviderHealthV1();if(v["status"]!="ok")res.status=503;providerReply(res,v);}catch(...){res.status=503;providerReply(res,{{"status","unavailable"}});}});
g_explorerServer.Get("/api/supply",[this,providerReply](const httplib::Request&,httplib::Response& res){try{providerReply(res,getDataProviderSupplyV1());}catch(...){res.status=503;res.set_header("Retry-After","30");providerReply(res,{{"error","supply snapshot unavailable; retry after 30 seconds"}});}});
g_explorerServer.Get(R"(/api/supply/(total|circulating|max))",[this,providerReply](const httplib::Request& req,httplib::Response& res){try{const auto v=getDataProviderSupplyV1();const std::string key=std::string(req.matches[1])+"_supply";if(v[key].is_null()){res.status=503;providerReply(res,{{"error","circulating supply policy has not been reviewed"}});return;}res.set_header("Access-Control-Allow-Origin","*");res.set_header("Cache-Control","no-store");res.set_content(v[key].get<std::string>()+"\n","text/plain");}catch(...){res.status=503;providerReply(res,{{"error","supply snapshot unavailable"}});}});
